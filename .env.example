# Whichever credential arrives first — src/jira/ works with either.
# Force one with JIRA_BACKEND=rest|mcp; otherwise MCP wins when its token is set.

# --- REST path (API token: id.atlassian.com > Security > API tokens, ~2 minutes) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- MCP path (brief §4 preferred: OAuth against https://mcp.atlassian.com/v1/mcp) ---
JIRA_MCP_TOKEN=
# JIRA_MCP_URL=https://mcp.atlassian.com/v1/mcp
# JIRA_CLOUD_ID=

# Target Jira project the hono backlog is imported into. Needed before import --go.
JIRA_PROJECT_KEY=

# OPENAI_API_KEY=            # optional; OpenRouter is the primary provider
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
